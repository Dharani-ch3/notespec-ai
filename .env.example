# Which model writes the spec: offline | openai | anthropic | ollama
ENGINE_PROVIDER=offline
# Embeddings for vector search: hashing (local, free) | openai | ollama
ENGINE_EMBEDDER=hashing
ENGINE_DB_PATH=data/engine.db

# Cloud models (only needed for that provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=   # an Anthropic model id from their docs

# Local models via Ollama (offline / air-gapped)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional auth. Format: actor:role:key, roles are viewer | editor | approver.
# Leave empty for open demo mode.
ENGINE_API_KEYS=
